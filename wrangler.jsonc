// Wrangler configuration for the Worker: its runtime flags, bindings, and vars. Blocks between
// `@starter:mcp`, `@starter:oauth`, `@starter:web`, or `@starter:access` and `@starter:end` belong
// to one part of the template, so a project that drops that part can delete them.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "url-super-stretcher",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  // Production serves on the custom domain only. `preview_urls` keeps Previews on workers.dev.
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "urlsuperstretcher.com", "custom_domain": true }],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  "vars": {
    "APP_NAME": "URL Super Stretcher",
    "ENVIRONMENT": "production",
    // @starter:web
    // Whether the web app's private routes need a Cloudflare Access identity: `public` or
    // `private`. `private` needs both Access vars, and fails closed without them.
    "WEB_ACCESS": "public",
    // @starter:end
    // @starter:access
    // Cloudflare Access team domain and the AUD tag of the Access application. Identities from any
    // other application are rejected. With both empty, no request has an identity.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // @starter:end
  },
  // Previews inherit nothing from production, so every var and binding is declared again.
  // `secrets` isn't inherited either. Previews get secrets from `--secrets-file` or the base config.
  "previews": {
    "vars": {
      "APP_NAME": "URL Super Stretcher",
      "ENVIRONMENT": "preview",
      // @starter:web
      // The same value as in production.
      "WEB_ACCESS": "public",
      // @starter:end
      // @starter:access
      "ACCESS_TEAM_DOMAIN": "",
      "ACCESS_AUD": "",
      // @starter:end
    },
  },
  // @starter:access
  // Fakes `ctx.access` under `pnpm dev`. Production has no `ctx.access` behind the static assets
  // router. `src/http/access.ts` accepts the fake only when `aud` equals `ACCESS_AUD`, so keep the
  // two values the same.
  "access": {
    "dev": {
      "aud": "url-super-stretcher-dev",
      "identity": { "email": "dev@example.com", "name": "Dev User" },
    },
  },
  // @starter:end
}
